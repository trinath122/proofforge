# Copy to .env and fill in. Never commit .env.
# Not needed at all if you have already run `contree auth` on this machine.

NEBIUS_API_KEY=
# Sandboxes project (also read from the `contree auth` profile)
NEBIUS_PROJECT_ID=

# dev = Lightning only (cheapest), efficient, or max
PROOFFORGE_MODE=dev
PROOFFORGE_TASK_BUDGET_USD=0.25
PROOFFORGE_SESSION_BUDGET_USD=2.00
PROOFFORGE_MAX_FIX_ATTEMPTS=3
PROOFFORGE_BRANCH_WIDTH=1
